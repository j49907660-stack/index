<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#f4f7fb">
<title>MOC Food Feedback</title>

<style>
:root{
  --bg:#f4f7fb;
  --panel:rgba(255,255,255,.96);
  --text:#1f2937;
  --muted:#64748b;
  --line:#d9e2ef;
  --blue:#144f86;
  --green:#1f8a5b;
  --yellow:#d99a00;
  --softBlue:#e8f2fb;
  --softGreen:#e8f6ef;
  --softYellow:#fff5dc;
  --shadow:0 18px 45px rgba(15,23,42,.14);
}
*{box-sizing:border-box}
html,body{min-height:100%;margin:0}
body{
  font-family:Segoe UI,Arial,sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at 88% 10%,rgba(11,110,168,.10),transparent 28%),
    radial-gradient(circle at 18% 86%,rgba(31,138,91,.08),transparent 30%),
    linear-gradient(180deg,#f9fbfd,#f3f6fa 50%,#eef3f8);
}
button,input,textarea{font:inherit}
button{touch-action:manipulation}

.page{
  min-height:100vh;
  padding:18px 14px 44px;
}
.top{
  max-width:650px;
  margin:0 auto 12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}
.brand{
  display:flex;
  align-items:center;
  gap:9px;
  color:#24415c;
  font-size:13px;
  font-weight:800;
}
.brand img{
  width:42px;
  height:42px;
  object-fit:contain;
  background:#fff;
  border-radius:9px;
  padding:4px;
  border:1px solid #e2e8f0;
}
.langSwitch{
  display:flex;
  gap:6px;
  background:#eef3f8;
  border-radius:12px;
  padding:5px;
}
.langSwitch button{
  border:0;
  background:transparent;
  color:var(--blue);
  font-weight:800;
  border-radius:9px;
  padding:8px 12px;
  cursor:pointer;
}
.langSwitch button.active{
  background:var(--blue);
  color:white;
}
.shell{
  max-width:650px;
  margin:0 auto;
}
.card{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:var(--shadow);
  padding:18px;
}
.hero{
  text-align:center;
  padding:8px 10px 18px;
}
.logoBox{
  width:74px;
  height:74px;
  margin:0 auto 14px;
  border-radius:18px;
  display:grid;
  place-items:center;
  background:#fff;
  box-shadow:0 10px 30px rgba(20,79,134,.12);
  border:1px solid #e2e8f0;
}
.logoBox img{
  width:58px;
  height:58px;
  object-fit:contain;
  padding:3px;
}
.hero h1{
  font-size:29px;
  margin:0 0 8px;
}
.hero p{
  font-size:15px;
  color:var(--muted);
  line-height:1.45;
  margin:0;
}
.ratingLabel{
  font-size:14px;
  font-weight:800;
  color:#334155;
  margin:4px 0 12px;
  text-align:center;
}
.ratingGrid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:10px;
  margin:4px 0 10px;
}
.ratingBtn{
  border:1px solid #d7e2ef;
  background:white;
  border-radius:16px;
  padding:16px 6px;
  cursor:pointer;
  display:grid;
  place-items:center;
  gap:7px;
  transition:.16s ease;
  box-shadow:0 5px 15px rgba(15,23,42,.05);
}
.ratingBtn:hover{
  transform:translateY(-2px);
  border-color:#aac4dc;
}
.ratingBtn.selected{
  border-color:var(--blue);
  background:#eef6fd;
  box-shadow:0 8px 22px rgba(20,79,134,.16);
}
.ratingEmoji{font-size:29px;line-height:1}
.ratingNumber{font-weight:900;font-size:18px;color:#334155}
.ratingWord{font-size:11px;color:var(--muted)}
.ratingBtn.selected .ratingNumber{color:var(--blue)}

.notice{
  border-left:5px solid var(--blue);
  background:#eef6fd;
  padding:14px;
  border-radius:12px;
  color:#24415c;
  font-size:14px;
  line-height:1.45;
}
.notice.warning{
  border-left-color:var(--yellow);
  background:#fff8e8;
}
.details{
  display:none;
  margin-top:18px;
}
.details.active{display:block}
.formGroup{
  display:grid;
  gap:7px;
  margin-top:13px;
}
.formGroup label{
  font-size:13px;
  font-weight:800;
  color:#334155;
}
textarea{
  width:100%;
  min-height:90px;
  resize:vertical;
  padding:10px 11px;
  border:1px solid #cfd9e6;
  border-radius:10px;
  background:white;
  color:var(--text);
}
textarea:focus{
  outline:2px solid rgba(20,79,134,.15);
  border-color:var(--blue);
}
.photoDrop{
  border:2px dashed #cbd5e1;
  border-radius:16px;
  padding:16px;
  background:#f8fafc;
  text-align:center;
  cursor:pointer;
  transition:.15s;
}
.photoDrop:hover{
  border-color:#8eb5d5;
  background:#f2f8fd;
}
.photoDrop input{display:none}
.smallHint{
  font-size:12px;
  color:var(--muted);
  margin-top:8px;
}
.photoPreview{
  margin-top:12px;
  display:none;
}
.photoPreview.active{display:block}
.photoPreview img{
  max-width:100%;
  max-height:280px;
  border-radius:14px;
  border:1px solid var(--line);
}
.btn{
  border:0;
  border-radius:10px;
  padding:12px 14px;
  font-weight:700;
  cursor:pointer;
}
.btn.primary{
  background:var(--green);
  color:white;
  box-shadow:0 5px 14px rgba(31,138,91,.20);
}
.btn.secondary{
  background:#eef3f8;
  color:var(--blue);
}
.btn:disabled{
  opacity:.5;
  cursor:not-allowed;
}
.submitRow{
  margin-top:20px;
  display:grid;
  gap:10px;
}
.submitRow .btn{
  padding:13px 16px;
  font-size:15px;
}
.status{
  min-height:18px;
  font-size:12px;
  color:var(--muted);
}
.status.error{color:#b91c1c}
.status.ok{color:#166534}

.thankYou{
  display:none;
  text-align:center;
  padding:30px 20px;
}
.thankYou.active{display:block}
.thankIcon{
  width:76px;
  height:76px;
  border-radius:50%;
  margin:0 auto 16px;
  background:var(--softGreen);
  color:var(--green);
  display:grid;
  place-items:center;
  font-size:38px;
  font-weight:900;
}
.thankYou h2{margin:0 0 8px}
.thankYou p{color:var(--muted);margin:0 0 20px}

@media(max-width:620px){
  .page{padding:12px 10px 32px}
  .card{padding:15px}
  .hero h1{font-size:25px}
  .ratingGrid{gap:6px}
  .ratingBtn{padding:13px 3px;border-radius:14px}
  .ratingEmoji{font-size:25px}
  .ratingWord{display:none}
}
</style>
</head>

<body>
<div class="page">
  <div class="top">
    <div class="brand">
      <img src="data:image/png;base64," alt="MOC">
      <span>MOC Food Feedback</span>
    </div>

    <div class="langSwitch">
      <button id="langRu" type="button" onclick="setLanguage('ru')">RU</button>
      <button id="langEn" type="button" onclick="setLanguage('en')">EN</button>
    </div>
  </div>

  <main class="shell">
    <div class="card">
      <div id="formArea">
        <div class="hero">
          <div class="logoBox">
            <img src="data:image/png;base64," alt="MOC">
          </div>
          <h1 id="title">Оцените качество питания</h1>
          <p id="subtitle">Ваш отзыв поможет нам сделать питание лучше.</p>
        </div>

        <div class="ratingLabel" id="ratingLabel">Выберите оценку</div>

        <div class="ratingGrid">
          <button class="ratingBtn" type="button" data-rating="1" onclick="selectRating(1)">
            <span class="ratingEmoji">😞</span>
            <span class="ratingNumber">1</span>
            <span class="ratingWord" data-word="1">Плохо</span>
          </button>
          <button class="ratingBtn" type="button" data-rating="2" onclick="selectRating(2)">
            <span class="ratingEmoji">🙁</span>
            <span class="ratingNumber">2</span>
            <span class="ratingWord" data-word="2">Слабо</span>
          </button>
          <button class="ratingBtn" type="button" data-rating="3" onclick="selectRating(3)">
            <span class="ratingEmoji">😐</span>
            <span class="ratingNumber">3</span>
            <span class="ratingWord" data-word="3">Средне</span>
          </button>
          <button class="ratingBtn" type="button" data-rating="4" onclick="selectRating(4)">
            <span class="ratingEmoji">🙂</span>
            <span class="ratingNumber">4</span>
            <span class="ratingWord" data-word="4">Хорошо</span>
          </button>
          <button class="ratingBtn" type="button" data-rating="5" onclick="selectRating(5)">
            <span class="ratingEmoji">😄</span>
            <span class="ratingNumber">5</span>
            <span class="ratingWord" data-word="5">Отлично</span>
          </button>
        </div>

        <div id="positiveHint" class="notice" style="display:none;margin-top:16px"></div>

        <div id="details" class="details">
          <div class="notice warning" id="lowHint">
            Расскажите, пожалуйста, что именно можно улучшить. Комментарий и фото необязательны.
          </div>

          <div class="formGroup">
            <label id="commentLabel" for="comment">Комментарий</label>
            <textarea id="comment" maxlength="1200" placeholder="Что именно вам не понравилось?"></textarea>
          </div>

          <div class="formGroup">
            <label id="photoLabel">Фото</label>
            <label class="photoDrop">
              <input id="photo" type="file" accept="image/*" capture="environment" onchange="onPhotoSelected(event)">
              <strong id="photoChoose">📷 Нажмите, чтобы добавить фото</strong>
              <div class="smallHint" id="photoHint">Фото будет уменьшено перед отправкой.</div>
            </label>

            <div id="photoPreview" class="photoPreview">
              <img id="photoPreviewImg" alt="Preview">
              <div style="margin-top:8px">
                <button type="button" class="btn secondary" onclick="removePhoto()" id="removePhoto">
                  Удалить фото
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="submitRow">
          <button id="submitBtn" class="btn primary" type="button" onclick="submitFeedback()" disabled>
            Отправить отзыв
          </button>
          <div id="status" class="status"></div>
        </div>
      </div>

      <div id="thankYou" class="thankYou">
        <div class="thankIcon">✓</div>
        <h2 id="thanksTitle">Спасибо за обратную связь!</h2>
        <p id="thanksText">Ваш отзыв сохранён.</p>
        <button class="btn secondary" type="button" onclick="resetForm()" id="again">
          Оставить ещё один отзыв
        </button>
      </div>
    </div>
  </main>
</div>

<script>
const SUBMIT_FLOW_URL = "https://default810e707a0fee4c86951994811f49ad.0e.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/27/workflows/ebaa280e5405407199e6709738d49ce3/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=uPJfNO1e0atZOX5_9UCfhVyD_bhUo1os6spuLUYjQcI";

let currentLanguage = "ru";
let selectedRating = 0;
let selectedPhotoBase64 = "";
let selectedPhotoName = "";
let selectedPhotoMime = "";

const I18N = {
  ru:{
    title:"Оцените качество питания",
    subtitle:"Ваш отзыв поможет нам сделать питание лучше.",
    ratingLabel:"Выберите оценку",
    lowHint:"Расскажите, пожалуйста, что именно можно улучшить. Комментарий и фото необязательны.",
    comment:"Комментарий",
    commentPlaceholder:"Что именно вам не понравилось?",
    photo:"Фото",
    photoChoose:"📷 Нажмите, чтобы добавить фото",
    photoHint:"Фото будет уменьшено перед отправкой.",
    removePhoto:"Удалить фото",
    submit:"Отправить отзыв",
    sending:"Отправляем...",
    positive:"Спасибо! Если всё хорошо, просто нажмите «Отправить отзыв».",
    thanksTitle:"Спасибо за обратную связь!",
    thanksText:"Ваш отзыв сохранён.",
    again:"Оставить ещё один отзыв",
    words:["","Плохо","Слабо","Средне","Хорошо","Отлично"],
    selectFirst:"Сначала выберите оценку.",
    photoTooLarge:"Фото слишком большое.",
    imageError:"Не удалось подготовить фотографию.",
    sendError:"Не удалось отправить отзыв. Попробуйте ещё раз."
  },
  en:{
    title:"Rate the food quality",
    subtitle:"Your feedback helps us improve our food service.",
    ratingLabel:"Select a rating",
    lowHint:"Please tell us what could be improved. Comment and photo are optional.",
    comment:"Comment",
    commentPlaceholder:"What exactly did you not like?",
    photo:"Photo",
    photoChoose:"📷 Tap to add a photo",
    photoHint:"The image will be resized before upload.",
    removePhoto:"Remove photo",
    submit:"Submit feedback",
    sending:"Sending...",
    positive:"Thank you! If everything was good, just press “Submit feedback”.",
    thanksTitle:"Thank you for your feedback!",
    thanksText:"Your feedback has been saved.",
    again:"Leave another feedback",
    words:["","Poor","Below average","Average","Good","Excellent"],
    selectFirst:"Please select a rating first.",
    photoTooLarge:"The photo is too large.",
    imageError:"Could not prepare the photo.",
    sendError:"Could not submit feedback. Please try again."
  }
};

function setLanguage(lang){
  currentLanguage = lang === "en" ? "en" : "ru";
  const t = I18N[currentLanguage];

  document.documentElement.lang = currentLanguage;
  document.getElementById("title").textContent = t.title;
  document.getElementById("subtitle").textContent = t.subtitle;
  document.getElementById("ratingLabel").textContent = t.ratingLabel;
  document.getElementById("lowHint").textContent = t.lowHint;
  document.getElementById("commentLabel").textContent = t.comment;
  document.getElementById("comment").placeholder = t.commentPlaceholder;
  document.getElementById("photoLabel").textContent = t.photo;
  document.getElementById("photoChoose").textContent = t.photoChoose;
  document.getElementById("photoHint").textContent = t.photoHint;
  document.getElementById("removePhoto").textContent = t.removePhoto;
  document.getElementById("submitBtn").textContent = t.submit;
  document.getElementById("positiveHint").textContent = t.positive;
  document.getElementById("thanksTitle").textContent = t.thanksTitle;
  document.getElementById("thanksText").textContent = t.thanksText;
  document.getElementById("again").textContent = t.again;

  document.querySelectorAll("[data-word]").forEach(el=>{
    el.textContent = t.words[Number(el.dataset.word)];
  });

  document.getElementById("langRu").classList.toggle("active",currentLanguage==="ru");
  document.getElementById("langEn").classList.toggle("active",currentLanguage==="en");
}

function selectRating(rating){
  selectedRating = rating;

  document.querySelectorAll(".ratingBtn").forEach(btn=>{
    btn.classList.toggle("selected",Number(btn.dataset.rating)===rating);
  });

  const low = rating <= 3;
  document.getElementById("details").classList.toggle("active",low);
  document.getElementById("positiveHint").style.display = low ? "none" : "block";
  document.getElementById("submitBtn").disabled = false;
  setStatus("");
}

function setStatus(text,type=""){
  const el = document.getElementById("status");
  el.textContent = text;
  el.className = "status" + (type ? " " + type : "");
}

function compressImage(file,maxSide=1600,quality=.82){
  return new Promise((resolve,reject)=>{
    const reader = new FileReader();
    reader.onerror = ()=>reject(new Error("read"));
    reader.onload = ()=>{
      const img = new Image();
      img.onerror = ()=>reject(new Error("image"));
      img.onload = ()=>{
        let w = img.width;
        let h = img.height;
        const scale = Math.min(1,maxSide/Math.max(w,h));
        w = Math.max(1,Math.round(w*scale));
        h = Math.max(1,Math.round(h*scale));

        const canvas = document.createElement("canvas");
        canvas.width = w;
        canvas.height = h;
        canvas.getContext("2d").drawImage(img,0,0,w,h);

        const dataUrl = canvas.toDataURL("image/jpeg",quality);
        resolve({
          dataUrl,
          base64:dataUrl.split(",")[1],
          mime:"image/jpeg"
        });
      };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
  });
}

async function onPhotoSelected(event){
  const file = event.target.files?.[0];
  if(!file){
    removePhoto();
    return;
  }

  const t = I18N[currentLanguage];

  if(file.size > 15*1024*1024){
    setStatus(t.photoTooLarge,"error");
    event.target.value = "";
    return;
  }

  try{
    const result = await compressImage(file);
    selectedPhotoBase64 = result.base64;
    selectedPhotoMime = result.mime;
    selectedPhotoName = "food_feedback_" + new Date().toISOString().replace(/[:.]/g,"-") + ".jpg";

    document.getElementById("photoPreviewImg").src = result.dataUrl;
    document.getElementById("photoPreview").classList.add("active");
    setStatus("");
  }catch(e){
    setStatus(t.imageError,"error");
  }
}

function removePhoto(){
  selectedPhotoBase64 = "";
  selectedPhotoName = "";
  selectedPhotoMime = "";
  document.getElementById("photo").value = "";
  document.getElementById("photoPreviewImg").src = "";
  document.getElementById("photoPreview").classList.remove("active");
}

async function submitFeedback(){
  const t = I18N[currentLanguage];

  if(!selectedRating){
    setStatus(t.selectFirst,"error");
    return;
  }

  const btn = document.getElementById("submitBtn");
  btn.disabled = true;
  btn.textContent = t.sending;
  setStatus("");

  const lowRating = selectedRating <= 3;

  const payload = {
    rating:selectedRating,
    comment:lowRating ? document.getElementById("comment").value.trim() : "",
    photoFileName:lowRating ? selectedPhotoName : "",
    photoContentType:lowRating ? selectedPhotoMime : "",
    photoBase64:lowRating ? selectedPhotoBase64 : ""
  };

  try{
    const response = await fetch(SUBMIT_FLOW_URL,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(payload)
    });

    if(!response.ok){
      let detail = "";
      try{ detail = await response.text(); }catch(e){}
      throw new Error("HTTP " + response.status + (detail ? " — " + detail.slice(0,180) : ""));
    }

    document.getElementById("formArea").style.display = "none";
    document.getElementById("thankYou").classList.add("active");
  }catch(e){
    console.error(e);
    setStatus(t.sendError + " (" + e.message + ")","error");
    btn.disabled = false;
  }finally{
    btn.textContent = t.submit;
  }
}

function resetForm(){
  selectedRating = 0;
  document.querySelectorAll(".ratingBtn").forEach(btn=>btn.classList.remove("selected"));
  document.getElementById("comment").value = "";
  document.getElementById("details").classList.remove("active");
  document.getElementById("positiveHint").style.display = "none";
  removePhoto();
  setStatus("");

  document.getElementById("formArea").style.display = "block";
  document.getElementById("thankYou").classList.remove("active");
  document.getElementById("submitBtn").disabled = true;
}

(function init(){
  const params = new URLSearchParams(location.search);
  const lang = params.get("lang") === "en" ? "en" : "ru";
  setLanguage(lang);
})();
</script>
</body>
</html>
